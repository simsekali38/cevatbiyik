@model PagedResult<PracticeAreaDto>
<div class="practice-public practice-list">
    <header class="page-heading"><div class="container">
        <nav aria-label="İçerik yolu"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana sayfa</a></li>
            <li class="breadcrumb-item active" aria-current="page">Uzmanlık alanları</li>
        </ol></nav>
        <h1>Uzmanlık alanları</h1>
    </div></header>
    <section class="section-pad practice-results" aria-label="Çalışma alanları"><div class="container">
        @if (Model.Items.Count == 0)
        {
            <div class="empty-state"><h2>Henüz yayımlanmış çalışma alanı bulunmuyor.</h2><a asp-controller="Home" asp-action="Contact">İletişime geç</a></div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var area in Model.Items)
                {
                    <div class="col-md-6 col-lg-4">
                        <article class="content-card practice-card h-100">
                            <h2><a asp-action="Detail" asp-route-slug="@area.Slug">@area.Name</a></h2>
                            @if (CevatBiyik.Application.Validation.ContentPublication.Complete(area.ShortDescription))
                            {
                                <p>@area.ShortDescription</p>
                            }
                            <a class="text-link" asp-action="Detail" asp-route-slug="@area.Slug">Detayları incele <span class="visually-hidden">: @area.Name</span><span aria-hidden="true">↗</span></a>
                        </article>
                    </div>
                }
            </div>
        }
        @if (Model.HasPrevious || Model.HasNext)
        {
            <nav class="page-links" aria-label="Çalışma alanı sayfaları">
                @if (Model.HasPrevious) { <a class="btn btn-outline-primary" asp-action="Index" asp-route-page="@(Model.Page - 1)">Önceki sayfa</a> }
                <span aria-current="page">Sayfa @Model.Page</span>
                @if (Model.HasNext) { <a class="btn btn-outline-primary" asp-action="Index" asp-route-page="@(Model.Page + 1)">Sonraki sayfa</a> }
            </nav>
        }
        <div class="practice-contact practice-contact-list"><a class="btn btn-primary" asp-controller="Home" asp-action="Contact">İletişime geç <span aria-hidden="true">↗</span></a></div>
    </div></section>
</div>
