@model PracticeAreaDto
<div class="practice-public practice-detail">
    <article>
        <header class="page-heading"><div class="container reading-width">
            <nav aria-label="İçerik yolu"><ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana sayfa</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Uzmanlık alanları</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol></nav>
            <h1>@Model.Name</h1>
            @if (CevatBiyik.Application.Validation.ContentPublication.Complete(Model.ShortDescription))
            {
                <p class="practice-lead">@Model.ShortDescription</p>
            }
        </div></header>
        <div class="section-pad practice-reading"><div class="container reading-width">
            @if (CevatBiyik.Application.Validation.ContentPublication.Complete(Model.Content))
            {
                <rich-content value="@Model.Content"></rich-content>
            }
            <div class="practice-contact"><a class="btn btn-light" asp-controller="Home" asp-action="Contact">İletişime geç <span aria-hidden="true">↗</span></a></div>
            <a class="text-link practice-back" asp-action="Index"><span aria-hidden="true">←</span> Tüm çalışma alanları</a>
        </div></div>
    </article>
    <partial name="_RelatedLocations" />
</div>
