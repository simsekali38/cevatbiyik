@model int
@{
    string baslik = Model switch
    {
        404 => "Sayfa bulunamadı",
        403 => "Erişim reddedildi",
        429 => "Çok fazla istek gönderildi. Bir dakika sonra yeniden deneyin.",
        >= 500 => "Bir hata oluştu",
        _ => "İstek işlenemedi"
    };
    ViewData["Title"] = $"{Model} — {baslik}";
    ViewData["Robots"] = "noindex, nofollow";
}

<section class="page-heading"><div class="container"><p class="eyebrow">İSTEK SONUCU</p><h1>@Model</h1><p>@baslik</p></div></section>
<section class="section-pad"><div class="container"><a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Ana sayfaya dön</a></div></section>
