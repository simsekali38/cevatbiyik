@model ArticleDto
<article><header class="page-heading"><div class="container reading-width"><nav aria-label="İçerik yolu"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana sayfa</a></li><li class="breadcrumb-item"><a asp-action="Index">Makaleler</a></li></ol></nav><p class="eyebrow">MAKALE</p><h1>@Model.Title</h1><p><time datetime="@Model.PublishedAt?.ToString("yyyy-MM-dd")">@Model.PublishedAt?.ToString("dd.MM.yyyy")</time></p></div></header><div class="section-pad"><div class="container reading-width">@if(Model.Cover is { } cover){<img src="@cover.Url" alt="@cover.AltText" width="@cover.Width" height="@cover.Height" class="img-fluid mb-4" decoding="async" />}@if(Model.CategoryName is { } category){<p>Kategori: <a asp-action="Index" asp-route-topic="@Model.CategoryId">@category</a></p>}@if(Model.Tags.Count > 0){<ul class="list-inline" aria-label="Makale etiketleri">@foreach(var tag in Model.Tags){<li class="list-inline-item"><a asp-action="Index" asp-route-tag="@tag.Slug">@tag.Name</a></li>}</ul>}<p class="article-lead">@Model.Excerpt</p><div class="plain-content">@Model.Content</div><hr /><a class="text-link" asp-action="Index"><span aria-hidden="true">←</span> Tüm makaleler</a></div></div></article>
