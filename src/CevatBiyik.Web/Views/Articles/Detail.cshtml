@model ArticleDto
<article><header class="page-heading"><div class="container reading-width"><nav aria-label="İçerik yolu"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana sayfa</a></li><li class="breadcrumb-item"><a asp-action="Index">Makaleler</a></li></ol></nav><p class="eyebrow">MAKALE</p><h1>@Model.Title</h1><p><time datetime="@Model.PublishedAt?.ToString("yyyy-MM-dd")">@Model.PublishedAt?.ToString("dd.MM.yyyy")</time></p></div></header><div class="section-pad"><div class="container reading-width"><p class="article-lead">@Model.Excerpt</p><div class="plain-content">@Model.Content</div><hr /><a class="text-link" asp-action="Index"><span aria-hidden="true">←</span> Tüm makaleler</a></div></div></article>
