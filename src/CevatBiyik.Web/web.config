<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\CevatBiyik.Web.dll" stdoutLogEnabled="false" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="6291456" />
          <hiddenSegments><remove segment="App_Data" /><add segment="App_Data" /></hiddenSegments>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
