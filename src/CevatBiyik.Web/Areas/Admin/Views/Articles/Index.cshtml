@model IReadOnlyList<ArticleDto>
@{ ViewData["Title"] = "Makale yönetimi"; ViewData["HasNext"] = Model.Count == 20; }
<h1>Makale yönetimi</h1><a class="btn btn-primary mb-3" asp-action="Create">Makale ekle</a>
<div class="admin-table"><table class="table"><caption>Makale listesi</caption><thead><tr><th scope="col">Başlık</th><th scope="col">Durum</th><th scope="col">İşlemler</th></tr></thead><tbody>
@foreach(var item in Model) { <tr><th scope="row">@item.Title</th><td><span class="admin-status @(!item.IsActive ? "" : item.PublishedAt > DateTime.UtcNow ? "admin-status-scheduled" : "admin-status-published")">@(!item.IsActive ? "Taslak" : item.PublishedAt > DateTime.UtcNow ? "Planlandı" : "Yayın etkin")</span></td><td class="admin-row-actions"><a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" asp-antiforgery="false" class="admin-delete">@Html.AntiForgeryToken()<label><input type="checkbox" name="confirmed" value="true" required /> Bu kaydı silmeyi onaylıyorum</label><button class="btn btn-outline-danger" type="submit">Sil</button></form></td></tr> }
</tbody></table></div><partial name="_Paging" />
