@{
    var signedIn = User.IsInRole("Admin");
    var currentPath = Context.Request.Path.Value?.TrimEnd('/') ?? "";
    (string Title, (string Path, string Label)[] Links)[] groups =
    [
        ("Genel", [("/admin", "Yönetim özeti"), ("/admin/guide", "Başlangıç ve kullanım rehberi"), ("/admin/contact-messages", "İletişim mesajları")]),
        ("İçerik", [("/admin/articles", "Makaleler"), ("/admin/practice-areas", "Uzmanlık alanları"), ("/admin/taxonomy/categories", "Kategoriler"), ("/admin/taxonomy/tags", "Etiketler"), ("/admin/profile", "Avukat profili"), ("/admin/page-contents", "Sayfa içerikleri"), ("/admin/faq", "Sıkça sorulan sorular")]),
        ("Medya ve dosyalar", [("/admin/media", "Görsel kütüphanesi"), ("/admin/files", "Dosya kontrolü")]),
        ("SEO ve yapılandırma", [("/admin/page-seo", "Sayfa SEO ayarları"), ("/admin/locations", "Yerel içerikler"), ("/admin/seo", "SEO kontrolü"), ("/admin/redirects", "Yönlendirmeler"), ("/admin/settings", "Site ayarları")])
    ];
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" /><title>@ViewData["Title"] | Yönetim</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
    @if (ViewData["UseRichEditor"] is true)
    {
        <link rel="stylesheet" href="~/lib/quill/quill.core.css" asp-append-version="true" />
        <script src="~/lib/quill/quill.js" asp-append-version="true" defer></script>
    }
    <link rel="stylesheet" href="~/css/admin.min.css" asp-append-version="true" />
    <script src="~/lib/bootstrap/bootstrap.bundle.min.js" asp-append-version="true" defer></script>
    <script src="~/js/admin.min.js" asp-append-version="true" defer></script>
</head>
<body class="admin-body admin-no-js @(signedIn ? "" : "admin-auth")">
    <a class="skip-link" href="#icerik">Ana içeriğe geç</a>
    <header class="site-header admin-header"><div class="admin-header-inner">
        @if (signedIn)
        {
            <button type="button" class="btn admin-menu-toggle d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#admin-navigation" aria-controls="admin-navigation" aria-label="Yönetim menüsünü aç">Menü</button>
        }
        <a class="brand text-decoration-none" href="/admin"><img class="brand-emblem" src="~/images/brand/cevat-biyik-emblem.svg" width="52" height="52" alt="" /><span class="brand-name">Av. Cevat Bıyık<span class="brand-caption">YÖNETİM PANELİ</span></span></a>
        <div class="admin-header-actions">@if (signedIn) { <a class="admin-public-link" href="/admin/guide">Yardım ve başlangıç</a> }<a class="admin-public-link" href="/" target="_blank" rel="noopener noreferrer">Siteyi görüntüle <span class="visually-hidden">(yeni sekme)</span></a>
        @if (signedIn)
        {
            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" asp-antiforgery="false">@Html.AntiForgeryToken()<button class="btn btn-outline-primary" type="submit">Çıkış yap</button></form>
        }
        </div>
    </div></header>
    <div class="admin-shell">
    @if (signedIn)
    {
        <aside class="offcanvas-lg offcanvas-start admin-sidebar" tabindex="-1" id="admin-navigation" aria-labelledby="admin-menu-title">
            <div class="offcanvas-header"><h2 class="h5" id="admin-menu-title">Yönetim menüsü</h2><button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#admin-navigation" aria-label="Menüyü kapat"></button></div>
            <nav class="offcanvas-body admin-navigation" aria-label="Yönetim menüsü">
                @foreach (var group in groups)
                {
                    <div class="admin-nav-group"><p class="admin-nav-heading">@group.Title</p>
                    @foreach (var link in group.Links)
                    {
                        var active = currentPath == link.Path || (link.Path != "/admin" && currentPath.StartsWith(link.Path + "/", StringComparison.OrdinalIgnoreCase));
                        <a href="@link.Path" class="admin-nav-link @(active ? "is-active" : "")" aria-current="@(active ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="@(link.Path switch { "/admin" => "M3 3h7v7H3ZM14 3h7v7h-7ZM3 14h7v7H3ZM14 14h7v7h-7Z", "/admin/contact-messages" => "M3 5h18v14H3Zm0 0 9 7 9-7", "/admin/guide" => "M3 4h8v16H3Zm10 0h8v16h-8M7 8h2m6 0h2M7 12h2m6 0h2", "/admin/media" => "M3 3h18v18H3Zm0 14 6-6 5 5 3-3 4 4M15 7h2", "/admin/settings" => "M4 7h16M4 17h16M8 4v6m8 4v6", _ => "M5 3h14v18H5ZM8 8h8m-8 4h8m-8 4h5" })" /></svg><span>@link.Label</span></a>
                    }
                    </div>
                }
            </nav>
        </aside>
    }
    <main class="admin-main" id="icerik" tabindex="-1">
        @if (signedIn && currentPath != "/admin")
        {
            <nav class="admin-breadcrumb" aria-label="İçerik yolu"><a href="/admin">Yönetim</a><span aria-hidden="true">/</span><span aria-current="page">@ViewData["Title"]</span></nav>
        }
        @if (TempData["AdminSuccess"] is string success) { <p class="alert alert-success" role="status">@success</p> }
        @if (TempData["AdminError"] is string error) { <p class="alert alert-danger" role="alert">@error</p> }
        @if (signedIn && currentPath != "/admin" && currentPath != "/admin/guide")
        {
            <div class="admin-context-help"><p>@(currentPath switch {
                var p when p.StartsWith("/admin/articles", StringComparison.Ordinal) => "Makaleyi önce taslak olarak kaydedin. İçerik hazır olduğunda yayın durumunu açın; ileri tarih verirseniz yayın zamanı beklenir.",
                var p when p.StartsWith("/admin/profile", StringComparison.Ordinal) => "Profiliniz için doğrulanmış bilgileri girin. Metinleri düzenledikten sonra inceleme onayını tekrar işaretleyin.",
                var p when p.StartsWith("/admin/settings", StringComparison.Ordinal) => "E-posta, telefon ve adres gibi her bilgi ayrı bir ayardır. Var olan kaydı düzenleyin; aynı ayarı ikinci kez eklemeyin.",
                var p when p.StartsWith("/admin/page-contents", StringComparison.Ordinal) => "Ana sayfa ve hukuki metinler burada yönetilir. Bir metnin görünmesi için etkin ve incelenmiş olması gerekir.",
                var p when p.StartsWith("/admin/locations", StringComparison.Ordinal) => "Yerel sayfaları yalnızca özgün, doğrulanmış ve ziyaretçiye faydalı içerik varsa oluşturun. Eksik içerikler indekslenmez.",
                _ => "Bu bölümdeki kayıtları ekleyebilir ve düzenleyebilirsiniz. İşlemler ve ilk veri giriş sırası için kullanım rehberini açın."
            })</p><a href="/admin/guide">Adım adım yardım →</a></div>
        }
        @RenderBody()
        <footer class="admin-footer">Av. Cevat Bıyık · Yönetim paneli @if(signedIn){<a href="/admin/guide">Kullanım rehberi</a>}</footer>
    </main>
    </div>
</body>
</html>
