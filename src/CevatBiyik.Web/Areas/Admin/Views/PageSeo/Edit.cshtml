@model PageSeoInput
@{ ViewData["Title"] = "Sayfa SEO düzenle"; }
<h1>@ViewData["Title"]</h1><p>Boş alanlar sayfanın varsayılan değerini kullanır. Anahtar kelimeleri doğal tutun; doğrulanmamış hukuki iddialar eklemeyin.</p>
<form asp-action="Save" asp-route-id="@ViewData["EntityId"]" method="post" asp-antiforgery="false">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>
<label asp-for="Path" class="form-label">Sayfa</label><select asp-for="Path" class="form-select mb-3"><option value="/">Ana sayfa</option><option value="/hakkimda">Hakkımda</option><option value="/iletisim">İletişim</option><option value="/makaleler">Makaleler</option><option value="/uzmanlik-alanlari">Uzmanlık alanları</option></select>
@{ var choicesPage = (int)(ViewData["ChoicesPage"] ?? 1); }<nav class="mb-3" aria-label="Görsel seçenekleri">@if(choicesPage > 1){<a asp-action="Edit" asp-route-id="@ViewData["EntityId"]" asp-route-choicesPage="@(choicesPage - 1)">Önceki görseller</a>}@if((ViewData["Media"] as IReadOnlyList<MediaDto>)?.Count == 20){<a asp-action="Edit" asp-route-id="@ViewData["EntityId"]" asp-route-choicesPage="@(choicesPage + 1)">Diğer görseller</a>}</nav><p class="form-text">Görsel seçeneklerini değiştirmeden önce değişikliklerinizi kaydedin.</p>@Html.EditorFor(x => x.Seo)
<div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive">Etkin</label></div><button type="submit" class="btn btn-primary">Kaydet</button> <a asp-action="Index">Listeye dön</a></form>
