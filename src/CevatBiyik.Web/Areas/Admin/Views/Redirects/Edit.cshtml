@model RedirectInput
@{ ViewData["Title"] = "Yönlendirme düzenle"; }
<h1>Yönlendirme düzenle</h1><p>Örneğin /eski-yazi → /makaleler/yayimlanan-yazi. Yalnızca site içi yollar; sorgu, fragment, dış URL, zincir veya korunan rota kullanılamaz. Mevcut kaynak yolu sabittir.</p>
<form data-admin-form asp-action="Save" asp-route-id="@ViewData["EntityId"]" method="post" asp-antiforgery="false">@Html.AntiForgeryToken()
@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div> }
<div class="mb-3"><label asp-for="SourcePath" class="form-label">Eski yol</label><input asp-for="SourcePath" class="form-control" maxlength="200" required readonly="@(ViewData["EntityId"] is not null)" /><span asp-validation-for="SourcePath" class="field-error"></span></div>
<div class="mb-3"><label asp-for="DestinationPath" class="form-label">Yayımlanmış hedef yol</label><input asp-for="DestinationPath" class="form-control" maxlength="200" required /><span asp-validation-for="DestinationPath" class="field-error"></span></div>
<div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><span asp-validation-for="IsActive" class="field-error"></span><label asp-for="IsActive" class="form-check-label">301 yönlendirmeyi etkinleştir</label></div>
<p class="form-text">Hedef yayından kalkarsa kural çalışmaz. Etkin sayfanın URL'si yönlendirmeden önceliklidir. 301 yanıtları tarayıcılar/arama motorlarınca hatırlanabilir.</p>
<div class="admin-save-bar"><button class="btn btn-primary" type="submit">Değişiklikleri kaydet</button> <a asp-action="Index">Listeye dön</a><span class="admin-save-state" data-save-state role="status">Henüz değişiklik yapılmadı</span></div></form>
