@model PagedResult<LocationDto>
@{ViewData["Title"]="Yerel içerikler";}
<h1>Yerel içerikler</h1><p>Tekil konum sayfaları; hizmet × ilçe sayfaları otomatik oluşturulmaz.</p><a class="btn btn-primary mb-3" href="/admin/locations/edit">Konum ekle</a>
<div class="table-responsive"><table class="table"><caption>Yerel içerik ve indeksleme durumu</caption><thead><tr><th scope="col">Konum</th><th scope="col">Durum</th><th scope="col">Uyarılar</th><th scope="col">İşlemler</th></tr></thead><tbody>
@foreach(var item in Model.Items){<tr><th scope="row">@item.Name</th><td>@(item.Indexable ? "İndekslemeye uygun (global ayara bağlı)" : "noindex / taslak")</td><td><ul>@foreach(var warning in item.Warnings){<li>@warning</li>}</ul></td><td><a href="/admin/locations/edit/@item.Id">Düzenle</a><form method="post" action="/admin/locations/delete/@item.Id">@Html.AntiForgeryToken()<label><input type="checkbox" name="confirmed" value="true" required /> Silmeyi onaylıyorum</label><button class="btn btn-outline-danger" type="submit">Sil</button></form></td></tr>}
</tbody></table></div><nav aria-label="Yerel içerik sayfaları">@if(Model.HasPrevious){<a href="?page=@(Model.Page-1)">Önceki</a>} @if(Model.HasNext){<a href="?page=@(Model.Page+1)">Sonraki</a>}</nav>
