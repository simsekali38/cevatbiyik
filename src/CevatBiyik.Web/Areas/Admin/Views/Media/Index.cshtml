@model IReadOnlyList<MediaDto>
@{ ViewData["Title"] = "Görseller"; var page = (int)(ViewData["Page"] ?? 1); }
<h1>Görseller</h1><p>JPEG, PNG veya WebP; en fazla 5 MiB ve 16 milyon piksel. Görseller 1600 piksele kadar küçültülür; dosya bilgileri kaldırılır. Yüklediğiniz görseller herkese açık olur.</p>
<form asp-action="Upload" method="post" enctype="multipart/form-data" asp-antiforgery="false" class="mb-4">
@Html.AntiForgeryToken()<label for="file" class="form-label">Görsel</label><input id="file" name="file" type="file" accept="image/jpeg,image/png,image/webp" class="form-control mb-3" required />
<label for="altText" class="form-label">Görselin kısa açıklaması</label><input id="altText" name="altText" class="form-control mb-3" maxlength="200" required />
<button class="btn btn-primary" type="submit">Yükle</button></form>
<div class="row g-4">@foreach(var item in Model) { <div class="col-md-4"><article class="card h-100"><img src="@item.Url" alt="@item.AltText" width="@item.Width" height="@item.Height" class="img-fluid" loading="lazy" decoding="async" /><div class="card-body"><h2 class="h5">@item.AltText</h2><p>@item.Width × @item.Height · @((item.Bytes / 1024)) KiB</p><a href="@item.Url">Görseli aç</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" asp-antiforgery="false">@Html.AntiForgeryToken()<label><input type="checkbox" name="confirmed" value="true" required /> Listeden kaldırmayı onaylıyorum</label><button class="btn btn-sm btn-outline-danger" type="submit">Kaldır</button></form></div></article></div> }</div>
<p class="mt-3">Kullanılan görseller kaldırılamaz. Listeden kaldırılan görselin dosyası, eski bağlantıları korumak için saklanır.</p>
<nav aria-label="Görsel sayfaları">@if(page > 1){<a asp-action="Index" asp-route-page="@(page - 1)">Önceki</a>} @if(Model.Count == 20){<a asp-action="Index" asp-route-page="@(page + 1)">Sonraki</a>}</nav>
