@model TaxonomyInput
@{ ViewData["Title"] = "Kategori / etiket düzenle"; }
<h1>@ViewData["Title"]</h1><p>Adı değiştirmeniz mevcut URL'yi değiştirmez.</p>
<form data-admin-form asp-action="Save" asp-route-kind="@ViewData["Kind"]" asp-route-id="@ViewData["EntityId"]" method="post" asp-antiforgery="false">
@Html.AntiForgeryToken()@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div> }
<label asp-for="Name" class="form-label">Ad</label><input asp-for="Name" class="form-control mb-3" maxlength="150" required /><span asp-validation-for="Name" class="field-error"></span>
<div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><span asp-validation-for="IsActive" class="field-error"></span><label asp-for="IsActive">Etkin</label></div>
<div class="admin-save-bar"><button class="btn btn-primary" type="submit">Değişiklikleri kaydet</button> <a asp-action="Index" asp-route-kind="@ViewData["Kind"]">Listeye dön</a><span class="admin-save-state" data-save-state role="status">Henüz değişiklik yapılmadı</span></div></form>
