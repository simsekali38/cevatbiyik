@model IReadOnlyList<SiteSettingDto>
@{ ViewData["Title"] = "Site ayarları"; ViewData["HasNext"] = Model.Count == 20; }
<h1>Site ayarları</h1><p>İletişim bilgileri, site adı ve SEO açıklaması yönetilir. Parola ve teknik sırlar bu panelde saklanmaz.</p><a class="btn btn-primary mb-3" asp-action="Create">Ayar ekle</a>
<div class="admin-table"><table class="table"><caption>Site ayarı listesi</caption><thead><tr><th scope="col">Ayar</th><th scope="col">Değer</th><th scope="col">İşlemler</th></tr></thead><tbody>
@foreach(var item in Model) { <tr><th scope="row">@item.Key</th><td>@item.Value — @(item.IsActive ? "Etkin" : "Pasif")</td><td><a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" asp-antiforgery="false" class="admin-delete">@Html.AntiForgeryToken()<label><input type="checkbox" name="confirmed" value="true" required /> Bu kaydı silmeyi onaylıyorum</label><button class="btn btn-outline-danger" type="submit">Sil</button></form></td></tr> }
</tbody></table></div><partial name="_Paging" />
