@model UpdateSiteSettingDto
@{ ViewData["Title"] = "Site ayarı düzenle"; }
<h1>Site ayarı düzenle</h1>
<form asp-action="Save" asp-route-id="@ViewData["EntityId"]" method="post" asp-antiforgery="false">
@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>
<div class="mb-3"><label asp-for="Key" class="form-label">Ayar</label><select asp-for="Key" class="form-select">
<option value="Site.Name">Site adı</option><option value="Site.Description">Site / SEO açıklaması</option>
<option value="Contact.Name">İletişim adı</option><option value="Contact.Email">E-posta</option><option value="Contact.Phone">Telefon</option>
<option value="Contact.Address">Adres</option><option value="Contact.WorkingHours">Çalışma saatleri</option><option value="Contact.WhatsApp">WhatsApp</option>
</select></div>
<div class="mb-3"><label asp-for="Value" class="form-label">Değer</label><textarea asp-for="Value" class="form-control" rows="4" required maxlength="4000"></textarea></div>
<div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Sitede kullan</label></div>
<button class="btn btn-primary" type="submit">Kaydet</button> <a asp-action="Index">Listeye dön</a>
</form>
