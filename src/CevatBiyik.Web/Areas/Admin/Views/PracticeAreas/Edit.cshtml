@model CreatePracticeAreaDto
@{ ViewData["Title"] = "Uzmanlık alanı düzenle"; }
<h1>Uzmanlık alanı düzenle</h1><p>Yalnızca doğrulanmış çalışma alanlarını yayımlayın. Başlık, liste ve bağlantılar için içerik editörünü kullanın.</p>
<form data-admin-form asp-action="Save" asp-route-id="@ViewData["EntityId"]" method="post" asp-antiforgery="false">
@Html.AntiForgeryToken()@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div> }
<div class="mb-3"><label asp-for="Name" class="form-label">Ad</label><input asp-for="Name" class="form-control" required maxlength="200" /><span asp-validation-for="Name" class="field-error"></span></div>
<div class="mb-3"><label asp-for="ShortDescription" class="form-label">Kısa açıklama</label><textarea asp-for="ShortDescription" class="form-control" rows="3"></textarea><span asp-validation-for="ShortDescription" class="field-error"></span></div>
<div class="mb-3"><label asp-for="Content" class="form-label">İçerik</label><textarea data-rich-editor asp-for="Content" class="form-control" rows="8" maxlength="100000" required></textarea><span asp-validation-for="Content" class="field-error"></span></div>
<div class="mb-3"><label asp-for="SortOrder" class="form-label">Sıralama</label><input asp-for="SortOrder" type="number" min="0" class="form-control" /><span asp-validation-for="SortOrder" class="field-error"></span></div>
<div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><span asp-validation-for="IsActive" class="field-error"></span><label asp-for="IsActive" class="form-check-label">Etkin</label></div>
@{ var choicesPage = (int)(ViewData["ChoicesPage"] ?? 1); var choices = ViewData["Media"] as IReadOnlyList<MediaDto> ?? Array.Empty<MediaDto>(); }
<nav class="mb-3" aria-label="Görsel seçenekleri">@if(choicesPage > 1){<a asp-action="@(ViewData["EntityId"] is null ? "Create" : "Edit")" asp-route-id="@ViewData["EntityId"]" asp-route-choicesPage="@(choicesPage - 1)">Önceki görseller</a>} @if(choices.Count == 20){<a asp-action="@(ViewData["EntityId"] is null ? "Create" : "Edit")" asp-route-id="@ViewData["EntityId"]" asp-route-choicesPage="@(choicesPage + 1)">Diğer görseller</a>}</nav>
<p class="form-text">Görsel seçenek sayfasını değiştirmeden önce kaydedin.</p>@Html.EditorFor(x => x.Seo)
<div class="admin-save-bar"><button class="btn btn-primary" type="submit">Değişiklikleri kaydet</button> <a asp-action="Index">Listeye dön</a>
<span class="admin-save-state" data-save-state role="status">Henüz değişiklik yapılmadı</span></div></form>
