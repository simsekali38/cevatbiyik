@model IReadOnlyList<PracticeAreaDto>
@{ ViewData["Title"] = "Uzmanlık alanları"; ViewData["HasNext"] = Model.Count == 20; }
<h1>Uzmanlık alanları</h1><a class="btn btn-primary mb-3" asp-action="Create">Alan ekle</a>
<div class="admin-table"><table class="table"><caption>Uzmanlık alanı listesi</caption><thead><tr><th scope="col">Ad</th><th scope="col">Durum</th><th scope="col">İşlemler</th></tr></thead><tbody>
@foreach(var item in Model) { <tr><th scope="row">@item.Name</th><td>@(item.IsActive ? "Etkin" : "Taslak")</td><td><a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" asp-antiforgery="false" class="admin-delete">@Html.AntiForgeryToken()<label><input type="checkbox" name="confirmed" value="true" required /> Bu kaydı silmeyi onaylıyorum</label><button class="btn btn-outline-danger" type="submit">Sil</button></form></td></tr> }
</tbody></table></div><partial name="_Paging" />
