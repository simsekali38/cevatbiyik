@model FaqInput
@{ ViewData["Title"] = "SSS düzenle"; }
<h1>@ViewData["Title"]</h1><p>Yalnızca kontrol edilmiş yanıtlar yayımlanır. İnceleme onayı her düzenlemede yeniden işaretlenir.</p>
<form data-admin-form asp-action="Save" asp-route-id="@ViewData["EntityId"]" method="post" asp-antiforgery="false">
@Html.AntiForgeryToken()@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div> }
<label asp-for="Question" class="form-label">Soru</label><input asp-for="Question" class="form-control mb-3" maxlength="250" required /><span asp-validation-for="Question" class="field-error"></span>
<label asp-for="Answer" class="form-label">Yanıt</label><textarea data-rich-editor asp-for="Answer" class="form-control mb-3" rows="8" maxlength="4000" required></textarea><span asp-validation-for="Answer" class="field-error"></span>
<label asp-for="SortOrder" class="form-label">Sıralama</label><input asp-for="SortOrder" class="form-control mb-3" type="number" min="0" max="10000" /><span asp-validation-for="SortOrder" class="field-error"></span>
<div class="form-check mb-3"><input asp-for="IsReviewed" class="form-check-input" /><span asp-validation-for="IsReviewed" class="field-error"></span><label asp-for="IsReviewed">Soru/yanıt ve yayın uygunluğu kontrol edilmiştir.</label></div>
<div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><span asp-validation-for="IsActive" class="field-error"></span><label asp-for="IsActive">Yayımla</label></div>
<div class="admin-save-bar"><button class="btn btn-primary" type="submit">Değişiklikleri kaydet</button> <a asp-action="Index">Listeye dön</a><span class="admin-save-state" data-save-state role="status">Henüz değişiklik yapılmadı</span></div></form>
