@model ProfileInput
@{ ViewData["Title"] = "Profil yönetimi"; }
<h1>Profil yönetimi</h1><p>Yalnızca doğrulanmış biyografi, vizyon ve baro adı girin. T.C. kimlik veya sicil numarası eklemeyin. Her düzenlemede yayımlama onayı yeniden işaretlenmelidir.</p>
<form data-admin-form asp-action="Save" method="post" asp-antiforgery="false">
@Html.AntiForgeryToken()@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div> }
<label asp-for="Biography" class="form-label">Biyografi</label><textarea data-rich-editor asp-for="Biography" class="form-control mb-3" rows="8" maxlength="5000" required></textarea><span asp-validation-for="Biography" class="field-error"></span>
<label asp-for="Vision" class="form-label">Vizyon</label><textarea data-rich-editor asp-for="Vision" class="form-control mb-3" rows="4" maxlength="2000" required></textarea><span asp-validation-for="Vision" class="field-error"></span>
<label asp-for="BarAssociation" class="form-label">Baro adı</label><input asp-for="BarAssociation" class="form-control mb-3" maxlength="150" required /><span asp-validation-for="BarAssociation" class="field-error"></span>
<div class="form-check mb-3"><input asp-for="IsReviewed" class="form-check-input" /><span asp-validation-for="IsReviewed" class="field-error"></span><label asp-for="IsReviewed">İçeriği ve yayın uygunluğunu inceledim; bilgiler doğrulanmıştır.</label></div>
<div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><span asp-validation-for="IsActive" class="field-error"></span><label asp-for="IsActive">Yayımla</label></div>
<div class="admin-save-bar"><button class="btn btn-primary" type="submit">Değişiklikleri kaydet</button><span class="admin-save-state" data-save-state role="status">Henüz değişiklik yapılmadı</span></div></form>
