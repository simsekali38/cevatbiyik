<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Runtime private files belong to the coordinated backup, never to a publish artifact. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);App_Data/**</DefaultItemExcludes>
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <!--
    Web: MVC controller'lar, Razor view'lar, Areas/Admin (Faz 03), middleware, statik dosyalar.
    Proje referans zinciri: Web -> Infrastructure -> Application -> Domain.
    Controller'lar Infrastructure somut tiplerini kullanmaz; kayıt AddInfrastructure içindedir.
  -->
  <PropertyGroup>
    <RootNamespace>CevatBiyik.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CevatBiyik.Infrastructure\CevatBiyik.Infrastructure.csproj" />
    <!-- Server-owned JSON and uploaded data must never be overwritten by a release. -->
    <!--<Content Update="appsettings*.json" CopyToPublishDirectory="Never" />-->
    <Content Update="secrets.json;*.local.json" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/uploads/**" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/uploads/web.config" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
</Project>
