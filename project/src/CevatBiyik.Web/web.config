<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\CevatBiyik.Web.dll" stdoutLogEnabled="false" hostingModel="outofprocess">
        <environmentVariables><environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" /></environmentVariables>
      </aspNetCore>
      <directoryBrowse enabled="false" />
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="6291456" />
          <hiddenSegments>
            <remove segment="App_Data" /><add segment="App_Data" />
            <remove segment="appsettings.json" /><add segment="appsettings.json" />
            <remove segment="appsettings.Production.json" /><add segment="appsettings.Production.json" />
            <remove segment=".git" /><add segment=".git" />
          </hiddenSegments>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
