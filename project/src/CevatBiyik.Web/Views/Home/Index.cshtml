@model HomeViewModel
@{ var site = ViewData["SiteSettings"] as PublicSiteSettings ?? PublicSiteSettings.Empty; }
@{
    var profile = ViewData["PublicProfile"] as ProfileDto;
    var hasEmail = CevatBiyik.Application.Validation.ContentPublication.Complete(site.Email);
    var hasPhone = CevatBiyik.Application.Validation.ContentPublication.Complete(site.Phone);
}
<div class="home-public">
<section class="hero" aria-labelledby="home-title"><div class="container"><div class="home-hero-grid">
    <div class="home-hero-copy"><p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span>HUKUK &amp; DANIŞMANLIK</p><h1 id="home-title" class="hero-title">Av. Cevat <span>Bıyık</span></h1><p class="hero-copy">Yayımlanan makaleleri okuyabilir, çalışma alanlarını inceleyebilir ve iletişim formunu kullanabilirsiniz.</p><div class="d-flex flex-wrap gap-3"><a class="btn home-gold-button" data-analytics-event="cta_click" asp-controller="Home" asp-action="Contact">Görüşme talebi <span aria-hidden="true">→</span></a><a class="btn home-outline-button" href="#yaklasim">Yaklaşım</a></div><p class="hero-advisory">Bu sitedeki içerikler genel bilgilendirme amacı taşır.</p></div>
    <figure class="home-hero-visual m-0">
        @if (Model.Hero is { } hero) { <img src="@hero.Url" alt="@hero.AltText" width="@hero.Width" height="@hero.Height" loading="eager" fetchpriority="high" decoding="async" /> }
        else { <img src="~/images/hero/representative-legal-still-life-1200.webp" asp-append-version="true" srcset="/images/hero/representative-legal-still-life-480.webp 480w, /images/hero/representative-legal-still-life-768.webp 768w, /images/hero/representative-legal-still-life-1200.webp 1200w" sizes="(min-width: 1248px) 600px, (min-width: 992px) 50vw, 100vw" width="1200" height="900" alt="Temsili kompozisyonda pirinç terazi, lacivert kitaplar ve açık not defteri" loading="eager" fetchpriority="high" decoding="async" /> }
        @if (Model.Hero is null) { <figcaption class="home-image-caption">Temsili görsel — yapay zekâ ile oluşturulmuştur.</figcaption> }
    </figure>
</div></div></section>
<section id="yaklasim" class="section-pad home-approach" aria-labelledby="intro-title"><div class="container"><div class="row g-4 align-items-start">
    <div class="col-lg-4"><p class="eyebrow">YAKLAŞIM</p><h2 id="intro-title">@(Model.Introduction?.Title ?? "Çalışma yaklaşımı")</h2>@if (Model.Introduction is { } introduction) { <rich-content value="@introduction.Body"></rich-content> } else { <p class="text-muted">Çalışma yaklaşımına ilişkin açıklama henüz yayımlanmadı.</p> }</div>
    <div class="col-lg-8"><div class="row g-3">
        <div class="col-md-4"><article class="content-card h-100"><span class="home-icon-badge"><partial name="_HomeIcon" model='@("scales")' /></span><h3>Çalışma alanları</h3><p>Yayımlanan çalışma alanlarını inceleyin.</p><a class="text-link" href="#calisma-alanlari">Alanları keşfedin →</a></article></div>
        <div class="col-md-4"><article class="content-card h-100"><span class="home-icon-badge"><partial name="_HomeIcon" model='@("book")' /></span><h3>Makaleler</h3><p>Yayımlanan bilgilendirici içeriklere ulaşın.</p><a class="text-link" href="#yayinlar">Makaleleri okuyun →</a></article></div>
        <div class="col-md-4"><article class="content-card h-100"><span class="home-icon-badge"><partial name="_HomeIcon" model='@("mail")' /></span><h3>İletişim</h3><p>İletişim bilgilerini ve formunu görüntüleyin.</p><a class="text-link" href="#iletisim">İletişime geçin →</a></article></div>
    </div></div>
</div></div></section>
<section id="calisma-alanlari" class="section-pad home-areas" aria-labelledby="areas-title"><div class="container">
    <div class="section-heading"><div><p class="eyebrow">ÇALIŞMA ALANLARI</p><h2 id="areas-title">Uzmanlık alanları</h2></div><a class="text-link" asp-controller="PracticeAreas" asp-action="Index">Tüm alanlar <span aria-hidden="true">→</span></a></div>
    @if (Model.PracticeAreas.Count == 0) { <div class="empty-state"><p class="mb-0">Henüz yayımlanmış çalışma alanı bulunmuyor.</p></div> }
    else
    {
        <div class="row g-4">@foreach (var area in Model.PracticeAreas) { <div class="col-md-4"><article class="content-card h-100"><span class="home-icon-badge"><partial name="_HomeIcon" model='@("scales")' /></span><h3><a asp-controller="PracticeAreas" asp-action="Detail" asp-route-slug="@area.Slug">@area.Name</a></h3>@if (CevatBiyik.Application.Validation.ContentPublication.Complete(area.ShortDescription)) { <p>@area.ShortDescription</p> }<a class="text-link" asp-controller="PracticeAreas" asp-action="Detail" asp-route-slug="@area.Slug">@area.Name hakkında <span aria-hidden="true">↗</span></a></article></div> }</div>
    }
</div></section>
<section class="section-pad home-profile" aria-labelledby="profile-title"><div class="container"><div class="row g-5 align-items-center"><div class="col-lg-5"><figure class="home-profile-visual m-0"><img src="~/images/hero/representative-law-office-768.webp" asp-append-version="true" srcset="/images/hero/representative-law-office-480.webp 480w, /images/hero/representative-law-office-768.webp 768w" sizes="(min-width: 992px) 480px, 100vw" width="768" height="960" loading="lazy" decoding="async" alt="Temsili hukuk ofisinde çalışma masası ve kitaplık" /><figcaption>Temsili hukuk ofisi — yapay zekâ ile oluşturulmuştur.</figcaption></figure></div><div class="col-lg-7"><p class="eyebrow">PROFİL</p><h2 id="profile-title">Av. Cevat Bıyık</h2><div class="home-profile-card">@if (profile is { IsActive: true, IsReviewed: true }) { <rich-content value="@profile.Biography"></rich-content> } else { <p>Profil bilgileri henüz yayımlanmadı.</p> }</div><a class="btn btn-primary" asp-controller="Home" asp-action="About">Hakkımda <span aria-hidden="true">→</span></a></div></div></div></section>
<section id="gorusme-sureci" class="section-pad" aria-labelledby="process-title"><div class="container"><div class="row g-4"><div class="col-lg-5"><p class="eyebrow">GÖRÜŞME SÜRECİ</p><h2 id="process-title">Görüşme hakkında</h2><p class="text-muted">Görüşme sürecine ilişkin açıklama henüz yayımlanmadı.</p></div><div class="col-lg-7"><ol class="home-process"><li><span class="home-step" aria-hidden="true">1</span><div><h3>İletişim bilgileri</h3><p>Mevcut iletişim kanallarını görüntüleyin.</p></div></li><li><span class="home-step" aria-hidden="true">2</span><div><h3>İletişim formu</h3><p>Mesajınızı iletişim sayfasındaki form üzerinden iletin.</p></div></li><li><span class="home-step" aria-hidden="true">3</span><div><h3>Bilgilendirme</h3><p>Formu göndermeden önce aydınlatma metnini inceleyin.</p></div></li></ol></div></div></div></section>
<section id="yayinlar" class="section-pad article-section" aria-labelledby="articles-title"><div class="container">
    <div class="section-heading"><div><p class="eyebrow">YAYINLAR</p><h2 id="articles-title">Son makaleler</h2></div><a class="text-link" asp-controller="Articles" asp-action="Index">Tüm makaleler <span aria-hidden="true">→</span></a></div>
    @if (Model.Articles.Count == 0) { <div class="empty-state"><p class="mb-0">Henüz yayımlanmış makale bulunmuyor.</p></div> }
    else
    {
        <div class="row g-4">@foreach (var article in Model.Articles) { <div class="col-md-4"><article class="content-card home-article-card h-100"><div class="home-article-cover">@if (article.Cover is { } cover) { <img src="@cover.Url" alt="@cover.AltText" width="@cover.Width" height="@cover.Height" loading="lazy" decoding="async" /> } else { <div class="home-article-placeholder"><partial name="_HomeIcon" model='@("book")' /></div> }</div><div class="home-article-body"><p class="eyebrow"><time datetime="@article.PublishedAt?.ToString("yyyy-MM-dd")">@article.PublishedAt?.ToString("dd.MM.yyyy")</time></p><h3><a asp-controller="Articles" asp-action="Detail" asp-route-slug="@article.Slug">@article.Title</a></h3>@if (CevatBiyik.Application.Validation.ContentPublication.Complete(article.Excerpt)) { <p>@article.Excerpt</p> }<a class="text-link" asp-controller="Articles" asp-action="Detail" asp-route-slug="@article.Slug">Makaleyi oku <span class="visually-hidden">: @article.Title</span><span aria-hidden="true">↗</span></a></div></article></div> }</div>
    }
</div></section>
<section id="iletisim" class="section-pad home-contact" aria-labelledby="home-contact-title"><div class="container"><div class="row g-4 align-items-center"><div class="col-lg-6"><p class="eyebrow">İLETİŞİM</p><h2 id="home-contact-title">İletişime geçin</h2><p>İletişim bilgilerine ulaşabilir ve mesajınızı form üzerinden gönderebilirsiniz.</p></div><div class="col-lg-5 offset-lg-1"><aside class="content-card"><p class="eyebrow">GÖRÜŞME TALEBİ</p>@if (hasEmail || hasPhone)
            {
                <dl class="contact-mini">
                    @if (hasEmail) { <dt><partial name="_HomeIcon" model='@("mail")' /> E-posta</dt><dd>@site.Email</dd> }
                    @if (hasPhone) { <dt><partial name="_HomeIcon" model='@("phone")' /> Telefon</dt><dd>@site.Phone</dd> }
                </dl>
            }
            else { <p>İletişim bilgileri ve mesaj formu için iletişim sayfasını inceleyin.</p> }<a class="btn btn-primary" data-analytics-event="cta_click" asp-controller="Home" asp-action="Contact">İletişim formunu aç →</a></aside></div></div></div></section>
</div>
