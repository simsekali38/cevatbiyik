@model PageContentDto
<div class="public-content-page legal-public">
<header class="container reading-width content-heading"><span class="public-icon-badge"><partial name="_PublicIcon" model='@("book")' /></span><h1>@(Model?.Title ?? ViewData["FallbackTitle"])</h1></header>
<section class="legal-content"><div class="container reading-width"><div class="legal-document">
@if (Model is null) { <div class="empty-state"><p>Bu sayfanın metni henüz yayımlanmamıştır.</p><p class="mb-0">CONTENT_REQUIRED</p></div> }
else { <rich-content value="@Model.Body"></rich-content> }
</div></div></section>
</div>
