@model UpdateSiteSettingDto
@{ ViewData["Title"] = "Site ayarı düzenle"; }
<h1>Site ayarı düzenle</h1>
<form data-admin-form asp-action="Save" asp-route-id="@ViewData["EntityId"]" method="post" asp-antiforgery="false">
@Html.AntiForgeryToken()@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div> }
<div class="mb-3"><label asp-for="Key" class="form-label">Ayar</label><select asp-for="Key" class="form-select">
<option value="Site.Name">Site adı</option><option value="Site.Description">Site / SEO açıklaması</option>
<option value="Contact.Name">İletişim adı</option><option value="Contact.Email">E-posta</option><option value="Contact.Phone">Telefon</option>
<option value="Contact.Address">Adres</option><option value="Contact.WorkingHours">Çalışma saatleri</option><option value="Contact.WhatsApp">WhatsApp</option>
<option value="Home.HeroMediaId">Ana sayfa hero görseli (medya ID)</option>
</select><p class="form-text">Hero seçimi için Medya panelinden yüklediğiniz görselin ID numarasını kullanın. Dosya yolu veya URL girmeyin.</p></div>
<div class="mb-3"><label asp-for="Value" class="form-label">Değer</label><textarea asp-for="Value" class="form-control" rows="4" required maxlength="4000"></textarea><span asp-validation-for="Value" class="field-error"></span></div>
<div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><span asp-validation-for="IsActive" class="field-error"></span><label asp-for="IsActive" class="form-check-label">Sitede kullan</label></div>
<div class="admin-save-bar"><button class="btn btn-primary" type="submit">Değişiklikleri kaydet</button> <a asp-action="Index">Listeye dön</a>
<span class="admin-save-state" data-save-state role="status">Henüz değişiklik yapılmadı</span></div></form>
