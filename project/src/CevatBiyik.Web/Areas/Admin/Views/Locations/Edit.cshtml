@model LocationInput
@{ ViewData["UseRichEditor"] = true;ViewData["Title"]="Yerel içerik düzenle";var id=ViewData["EntityId"];var options=ViewData["Locations"] as IReadOnlyList<LocalLink> ?? Array.Empty<LocalLink>();var areas=ViewData["Areas"] as IReadOnlyList<PracticeAreaDto> ?? Array.Empty<PracticeAreaDto>();var articles=ViewData["Articles"] as IReadOnlyList<ArticleDto> ?? Array.Empty<ArticleDto>();var choicesPage=ViewData["ChoicesPage"] as int? ?? 1;}
<h1>Yerel içerik düzenle</h1><div class="alert alert-info">Yerel gerçekleri ve özgün kullanıcı değerini inceleyin. Bilinmeyen alanları CONTENT_REQUIRED bırakın. Kaydetmek kalite kontrolünü geçmek veya indekslemeyi açmak anlamına gelmez. Tür, üst konum ve slug oluşturulduktan sonra sabittir.</div>
@if(ViewData["QualityWarnings"] is IReadOnlyList<string> warnings && warnings.Count > 0){<div class="alert alert-warning"><h2 class="h5">İndeksleme kontrolü</h2><ul>@foreach(var warning in warnings){<li>@warning</li>}</ul></div>}
<form data-admin-form method="post" action="/admin/locations/save/@id">@Html.AntiForgeryToken()@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="text-danger" role="alert"></div> }
<div class="mb-3"><label asp-for="Name" class="form-label">Konum adı</label><input asp-for="Name" class="form-control" maxlength="100" required /><span asp-validation-for="Name" class="field-error"></span></div>
<div class="mb-3"><label asp-for="Kind" class="form-label">Tür</label><select asp-for="Kind" class="form-select"><option value="0">İl (Kayseri)</option><option value="1">İlçe</option><option value="2">Bölge</option></select></div>
<div class="mb-3"><label asp-for="ParentId" class="form-label">Üst konum</label><select asp-for="ParentId" class="form-select"><option value="">Yok (yalnızca il)</option>@foreach(var option in options){<option value="@option.Id">@option.Title</option>}</select></div>
<div class="mb-3"><label asp-for="Summary" class="form-label">Özet</label><textarea asp-for="Summary" class="form-control" rows="3" maxlength="500" required></textarea><span asp-validation-for="Summary" class="field-error"></span></div>
<div class="mb-3"><label asp-for="Body" class="form-label">Ana içerik</label><textarea data-rich-editor asp-for="Body" class="form-control" rows="10" maxlength="12000" required></textarea><span asp-validation-for="Body" class="field-error"></span></div>
<div class="mb-3"><label asp-for="LocalDetails" class="form-label">Konuma özgü, doğrulanabilir açıklama</label><textarea asp-for="LocalDetails" class="form-control" rows="6" maxlength="4000" required></textarea><span asp-validation-for="LocalDetails" class="field-error"></span><p class="form-text">Adres/ofis varlığı veya hizmet kapsamı uydurmayın. Yer adını değiştiren kopya metinler uygun değildir.</p></div>
<div class="form-check"><input asp-for="IsReviewed" class="form-check-input" /><span asp-validation-for="IsReviewed" class="field-error"></span><label asp-for="IsReviewed" class="form-check-label">İçeriği hukuki doğruluk ve kullanıcı değeri açısından inceledim</label></div>
<div class="form-check"><input asp-for="FactsVerified" class="form-check-input" /><span asp-validation-for="FactsVerified" class="field-error"></span><label asp-for="FactsVerified" class="form-check-label">Konum ve yerel hizmet/iletişim bilgilerini doğruladım</label></div>
<div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><span asp-validation-for="IsActive" class="field-error"></span><label asp-for="IsActive" class="form-check-label">Yayımla (kalite kontrolü ayrıca uygulanır)</label></div>
<fieldset class="mb-3"><legend>İlgili çalışma alanları (en fazla 20)</legend>@foreach(var selected in Model.PracticeAreaIds.Where(x=>areas.All(a=>a.Id!=x))){<label class="d-block"><input type="checkbox" name="PracticeAreaIds" value="@selected" checked /> Mevcut seçim #@selected</label>}@foreach(var area in areas){<label class="d-block"><input type="checkbox" name="PracticeAreaIds" value="@area.Id" checked="@(Model.PracticeAreaIds.Contains(area.Id))" /> @area.Name</label>}</fieldset>
<fieldset class="mb-3"><legend>İlgili yayımlanmış makaleler (en fazla 20)</legend>@foreach(var selected in Model.ArticleIds.Where(x=>articles.All(a=>a.Id!=x))){<label class="d-block"><input type="checkbox" name="ArticleIds" value="@selected" checked /> Mevcut seçim #@selected</label>}@foreach(var article in articles){<label class="d-block"><input type="checkbox" name="ArticleIds" value="@article.Id" checked="@(Model.ArticleIds.Contains(article.Id))" /> @article.Title</label>}</fieldset>
@Html.EditorFor(x=>x.Seo)
<div class="admin-save-bar"><button type="submit" class="btn btn-primary">Değişiklikleri kaydet</button><a class="btn btn-link" href="/admin/locations">Listeye dön</a><span class="admin-save-state" data-save-state role="status">Henüz değişiklik yapılmadı</span></div></form>
@if(id is not null){<nav class="mt-3" aria-label="İçerik ve medya seçenekleri"><p>Seçenek sayfasını değiştirmeden önce kaydedin.</p>@if(choicesPage>1){<a href="/admin/locations/edit/@id?choicesPage=@(choicesPage-1)">Önceki seçenekler</a>} <a href="/admin/locations/edit/@id?choicesPage=@(choicesPage+1)">Sonraki seçenekler</a></nav>}
