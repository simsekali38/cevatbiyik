@model IReadOnlyList<PageSeoDto>
@{ ViewData["Title"] = "Sayfa SEO ayarları"; }
<h1>@ViewData["Title"]</h1><a asp-action="Edit" class="btn btn-primary mb-3">Yeni sayfa ayarı</a>
<table class="table"><caption>Sayfa ayarları</caption><thead><tr><th scope="col">Sayfa</th><th scope="col">Başlık</th><th scope="col">Durum</th><th scope="col">İşlemler</th></tr></thead><tbody>
@foreach(var item in Model){<tr><td>@item.Path</td><td>@item.Seo.MetaTitle</td><td>@(item.IsActive ? "Etkin" : "Pasif")</td><td class="admin-row-actions"><a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a><form asp-action="Disable" asp-route-id="@item.Id" method="post" asp-antiforgery="false">@Html.AntiForgeryToken()<label><input type="checkbox" name="confirmed" value="true" required /> Devre dışı bırakmayı onaylıyorum</label> <button type="submit" class="btn btn-sm btn-outline-danger">Devre dışı bırak</button></form></td></tr>}
</tbody></table>
