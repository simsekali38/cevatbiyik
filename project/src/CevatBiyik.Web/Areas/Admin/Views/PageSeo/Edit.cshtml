@model PageSeoInput
@{ ViewData["Title"] = "Sayfa SEO düzenle"; }
<h1>@ViewData["Title"]</h1><p>Boş alanlar sayfanın varsayılan değerini kullanır. Anahtar kelimeleri doğal tutun; doğrulanmamış hukuki iddialar eklemeyin.</p>
<form data-admin-form asp-action="Save" asp-route-id="@ViewData["EntityId"]" method="post" asp-antiforgery="false">@Html.AntiForgeryToken()@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div> }
<label asp-for="Path" class="form-label">Sayfa</label><select asp-for="Path" class="form-select mb-3"><option value="/">Ana sayfa</option><option value="/hakkimda">Hakkımda</option><option value="/iletisim">İletişim</option><option value="/makaleler">Makaleler</option><option value="/uzmanlik-alanlari">Uzmanlık alanları</option><option value="/sss">SSS</option><option value="/kvkk">KVKK / Aydınlatma</option><option value="/cerez-politikasi">Çerez Politikası</option><option value="/yasal-uyari">Yasal Uyarı</option></select>
@{ var choicesPage = (int)(ViewData["ChoicesPage"] ?? 1); }<nav class="mb-3" aria-label="Görsel seçenekleri">@if(choicesPage > 1){<a asp-action="Edit" asp-route-id="@ViewData["EntityId"]" asp-route-choicesPage="@(choicesPage - 1)">Önceki görseller</a>}@if((ViewData["Media"] as IReadOnlyList<MediaDto>)?.Count == 20){<a asp-action="Edit" asp-route-id="@ViewData["EntityId"]" asp-route-choicesPage="@(choicesPage + 1)">Diğer görseller</a>}</nav><p class="form-text">Görsel seçeneklerini değiştirmeden önce değişikliklerinizi kaydedin.</p>@Html.EditorFor(x => x.Seo)
<div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><span asp-validation-for="IsActive" class="field-error"></span><label asp-for="IsActive">Etkin</label></div><div class="admin-save-bar"><button type="submit" class="btn btn-primary">Değişiklikleri kaydet</button> <a asp-action="Index">Listeye dön</a><span class="admin-save-state" data-save-state role="status">Henüz değişiklik yapılmadı</span></div></form>
